# Transcode worker configuration.
#
# The same container image runs locally and in the cloud; only these values differ. The
# worker accepts no inbound connections — it reaches out to Redis, the bucket and the
# callback URL — so a worker on a laptop behind NAT needs no tunnelling or port forwarding.
#
# Two variables are absent on purpose, and both are security properties:
#   - No DATABASE_URL. Results travel over the signed callback, never a direct write, so a
#     compromised worker box holds no database credential.
#   - No S3_PUBLIC_ENDPOINT. The worker never presigns for a browser.

# Must match the API's REDIS_URL and TRANSCODE_QUEUE_NAME. A queue-name mismatch is
# silent: jobs pile up in a queue nobody reads and neither side logs an error.
REDIS_URL=redis://localhost:6379
TRANSCODE_QUEUE_NAME=transcode

# In production this credential should be scoped to s3:GetObject on */source.mp4 and
# s3:PutObject/DeleteObject on videos/* — never a broad root key. Treat the machine
# running this worker as trusted; do not run it on a shared or public box.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smartteacher
S3_SECRET_ACCESS_KEY=smartteacher
S3_INGEST_BUCKET=ingest-bucket
S3_FORCE_PATH_STYLE=true

# Must match the API's WORKER_CALLBACK_SECRET exactly; every callback is HMAC-signed with
# it. This one value is what stands between an unauthenticated caller and the ability to
# flip any video to READY.
CALLBACK_URL=http://localhost:4000/internal/transcode/callback
WORKER_CALLBACK_SECRET=dev-worker-callback-secret-4f1c9a27be3d05e8

# Jobs per worker. Kept low because every concurrent job shares one Node event loop, and
# BullMQ renews job locks on that same loop — one blocked operation endangers every
# in-flight lease, not just its own. Also caps scratch disk: CONCURRENCY x (source + HLS).
CONCURRENCY=2

# name:height:videoBitrate:audioBitrate, ascending by video bitrate. Two rungs is the
# minimum that lets a client step down on 3G instead of stalling; a single rendition
# cannot adapt however it is packaged.
RENDITION_LADDER=360p:360:800k:96k,720p:720:2500k:128k

# none | nvenc | videotoolbox. Leave at none unless the whole fleet is homogeneous: NVENC
# output differs visibly from libx264 at the same bitrate, so a GPU worker and a CPU
# worker on one queue would produce inconsistent renditions for the same library.
# videotoolbox is macOS-only and unavailable inside a Linux container.
HWACCEL=none

# Scratch space for downloads and encodes. Must be writable and roomy — see CONCURRENCY.
WORK_DIR=/tmp/transcode

# Asserted against the actual binary at boot; the worker refuses to start on a mismatch.
# Baked into the container image, so it only needs setting when running natively.
EXPECTED_FFMPEG_VERSION=7.0.2
