PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://smartteacher:smartteacher@localhost:5432/smartteacher?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRY=30d

# Base URL of the web app, used to build links in invite emails
WEB_APP_URL=http://localhost:3000

# Gmail SMTP: use an App Password, not your account password
# (Google Account > Security > 2-Step Verification > App passwords — requires 2FA enabled).
# "Less secure app access" is deprecated and no longer works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=change-me-app-password
MAIL_FROM_NAME=Smart Teacher
MAIL_FROM_ADDRESS=your-address@gmail.com

# Object storage for video ingest. These defaults target the local MinIO container
# (docker compose up -d minio); S3_FORCE_PATH_STYLE must stay true for MinIO, which
# cannot serve virtual-hosted bucket URLs off localhost. For real S3, drop S3_ENDPOINT
# to the regional endpoint and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
# Where the browser PUTs. Identical to S3_ENDPOINT when the API runs natively; they
# diverge only under docker compose, where this process reaches MinIO at minio:9000
# but the browser still needs localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smartteacher
S3_SECRET_ACCESS_KEY=smartteacher
S3_INGEST_BUCKET=ingest-bucket
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_EXPIRY_SECS=900
S3_DOWNLOAD_URL_EXPIRY_SECS=300
RETAIN_INGEST_SOURCE=true

PLAYBACK_TOKEN_SECRET=change-me-playback-token-secret-min-32-chars
PLAYBACK_TOKEN_TTL_SECS=14400

# Transcode pipeline. The API enqueues jobs here and receives signed callbacks; the
# worker that consumes them lives in apps/worker and may run anywhere with outbound
# access to Redis, the bucket and this API. REDIS_URL, TRANSCODE_QUEUE_NAME and
# WORKER_CALLBACK_SECRET must match the worker's exactly — a mismatch is silent.
REDIS_URL=redis://localhost:6379
TRANSCODE_QUEUE_NAME=transcode
WORKER_CALLBACK_SECRET=change-me-worker-callback-secret-min-32-chars
TRANSCODE_CALLBACK_SKEW_SECS=300
# A video still QUEUED/PROCESSING after this long is presumed dead and swept to FAILED.
TRANSCODE_STALE_AFTER_MINS=45
