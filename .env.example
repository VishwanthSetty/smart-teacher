# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=smartteacher
POSTGRES_PASSWORD=smartteacher
POSTGRES_DB=smartteacher
POSTGRES_PORT=5432

# Used by docker-compose.yml for the api/web containers (dev-only defaults — override for anything real)
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=30d
WEB_APP_URL=http://localhost:3000

# Gmail SMTP: use an App Password, not your account password (see apps/api/.env.example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=change-me-app-password
MAIL_FROM_NAME=Smart Teacher
MAIL_FROM_ADDRESS=your-address@gmail.com

# MinIO container + the api container's view of it. MINIO_BROWSER_URL is what the
# browser must be able to reach: the api container talks to http://minio:9000, but a
# presigned URL is signed for whichever host the *browser* will PUT to, so the two
# differ and both are needed.
MINIO_ROOT_USER=smartteacher
MINIO_ROOT_PASSWORD=smartteacher
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_INGEST_BUCKET=ingest-bucket
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_UPLOAD_URL_EXPIRY_SECS=900
S3_DOWNLOAD_URL_EXPIRY_SECS=300
RETAIN_INGEST_SOURCE=true

# Playback signing. This committed P-256 key is for local development only.
PLAYBACK_DELIVERY_MODE=api
PLAYBACK_API_ORIGIN=http://localhost:4000
PLAYBACK_EDGE_ORIGIN=http://localhost:8787
PLAYBACK_SIGNING_KEY_ID=dev-1
PLAYBACK_SIGNING_PRIVATE_KEY_
PLAYBACK_TOKEN_TTL_SECS=600

# Transcode pipeline. Shared by the api and worker containers.
REDIS_PORT=6379
TRANSCODE_QUEUE_NAME=transcode
WORKER_CALLBACK_SECRET=change-me-worker-callback-secret-min-32-chars
TRANSCODE_CALLBACK_SKEW_SECS=300
TRANSCODE_STALE_AFTER_MINS=45

# Worker-only. CONCURRENCY caps jobs per worker so a bulk ingest cannot exhaust CPU/RAM;
# every concurrent job also shares one Node event loop, and a blocked loop stops BullMQ
# renewing its job locks. RENDITION_LADDER is name:height:videoBitrate:audioBitrate —
# two rungs is the minimum that lets a client step down on 3G instead of stalling.
# HWACCEL stays "none" by default: NVENC output differs visibly from libx264 at the same
# bitrate, so a mixed GPU/CPU fleet would produce inconsistent renditions.
TRANSCODE_CONCURRENCY=2
RENDITION_LADDER=360p:360:800k:96k,720p:720:2500k:128k
HWACCEL=none
